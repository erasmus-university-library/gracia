@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix gracia: <https://gracia.pub/ns/> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:     <http://example.org/shapes#> .

# ============================================================================
# The classes of an organization, as people see them: the name of a choice and of the tab
# of the form, and its icon (a Bootstrap icon)
# ============================================================================
schema:Organization rdfs:label "Organization" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "building" .
schema:EducationalOrganization rdfs:label "Educational organization" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "easel" .
schema:CollegeOrUniversity rdfs:label "College or university" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "mortarboard" .
schema:ResearchOrganization rdfs:label "Research organization" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "lightbulb" .
schema:Corporation rdfs:label "Corporation" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "briefcase" .
schema:FundingScheme rdfs:label "Funding scheme" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "cash-coin" .

# ============================================================================
# 1. Organization Shape
# ============================================================================
ex:OrganizationShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "building" ;
    sh:name "Organization" ;
    # the classes a resource of this type can have: one of them (the form has a choice)
    sh:targetClass schema:Organization ,
                   schema:EducationalOrganization ,
                   schema:CollegeOrUniversity ,
                   schema:ResearchOrganization ,
                   schema:Corporation ,
                   schema:FundingScheme ;

    # What kind of organization it is: one rdf:type, of the classes above. The labels in the
    # form are made of the names of the classes.
    sh:property [
        sh:path rdf:type ;
        sh:name "type" ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( schema:Organization
                schema:EducationalOrganization
                schema:CollegeOrUniversity
                schema:ResearchOrganization
                schema:Corporation
                schema:FundingScheme ) ;
        sh:message "An organization has one rdf:type: Organization, EducationalOrganization, CollegeOrUniversity, ResearchOrganization, Corporation or FundingScheme."
    ] ;

    # Primary display name (required)
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:order 1 ;
        dash:propertyRole dash:LabelRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An Organization must have exactly one schema:name string."
    ] ;

    # Official registered name
    sh:property [
        sh:path schema:legalName ;
        sh:name "legal name" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;

    # Acronyms, abbreviations (xsd:string), and translated names (rdf:langString)
    sh:property [
        sh:path schema:alternateName ;
        sh:name "alternate name" ;
        sh:order 3 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
        sh:message "schema:alternateName must be a plain string or a language-tagged string."
    ] ;

    # Sub-classification (e.g., Faculty, Department, ResearchGroup concept IRI)
    sh:property [
        sh:path schema:additionalType ;
        sh:name "additional type" ;
        sh:order 4 ;
        sh:nodeKind sh:IRI ;
        sh:message "schema:additionalType must be a concept IRI."
    ] ;

    # Structured identifiers (ROR, ISNI, KvK, internal org code, etc.)
    sh:property [
        sh:path schema:identifier ;
        sh:name "identifier" ;
        sh:order 9 ;
        sh:node ex:PropertyValueShape ;
        sh:message "schema:identifier must be a valid schema:PropertyValue node."
    ] ;

    # External authority URIs (ROR URL, Wikidata, etc.)
    sh:property [
        sh:path schema:sameAs ;
        sh:name "same as" ;
        sh:order 10 ;
        sh:nodeKind sh:IRI ;
        sh:message "schema:sameAs must be a valid IRI."
    ] ;

    # Official homepage
    sh:property [
        sh:path schema:url ;
        sh:name "URL" ;
        sh:order 6 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;

    # General contact email
    sh:property [
        sh:path schema:email ;
        sh:name "email" ;
        sh:order 7 ;
        sh:datatype xsd:string ;
        sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ;
        sh:message "schema:email must be a valid email string."
    ] ;

    # Description (supports plain strings and language-tagged strings like @en or @nl)
    sh:property [
        sh:path schema:description ;
        sh:name "description" ;
        dash:editor dash:TextAreaEditor ;
        sh:maxCount 1 ;
        sh:order 5 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
        sh:message "schema:description must be a plain string or a language-tagged string."
    ] ;

    # Physical / visiting address
    sh:property [
        sh:path schema:address ;
        sh:name "address" ;
        sh:order 8 ;
        sh:node ex:PostalAddressShape
    ] ;

    # Recursive organizational hierarchies (both upward and downward)
    sh:property [
        sh:path schema:parentOrganization ;
        sh:name "parent organization" ;
        sh:order 11 ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:node ex:OrganizationShape ] )
    ] ;
    sh:property [
        sh:path schema:subOrganization ;
        sh:name "sub organization" ;
        sh:order 12 ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:node ex:OrganizationShape ] )
    ] ;
    sh:property [
        sh:path schema:department ;
        sh:name "department" ;
        sh:order 13 ;
        sh:or ( [ sh:nodeKind sh:IRI ] [ sh:node ex:OrganizationShape ] )
    ] .

# ============================================================================
# 2. Structured Identifier Shape (schema:PropertyValue)
# ============================================================================
ex:PropertyValueShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "fingerprint" ;
    gracia:headerTemplate ( "{}" schema:value ) ;
    gracia:headerAddOnTemplate ( "{}" schema:propertyID ) ;
    sh:name "Property value" ;
    sh:class schema:PropertyValue ;

    # the kinds of identifier, and what the value of each looks like (the other kinds, a
    # local one and one of some other source, can be anything)
    sh:message "The value is not in the form of its kind: ROR 05gq02987, OpenAlex I114027177, Scopus 6 to 12 digits, Wikidata Q1065, GRID grid.4989.c" ;
    sh:or (
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "ROR" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^0[a-hj-km-np-tv-z0-9]{6}[0-9]{2}$" ;
            sh:message "A ROR id is nine characters that start with 0, like 05gq02987." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://ror\\.org/" ;
            sh:message "A ROR URL starts with https://ror.org/" ;
            gracia:propertyTemplate ( "https://ror.org/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "OpenAlex" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^[A-Za-z]\\d+$" ;
            sh:message "An OpenAlex id is a letter and digits, like I114027177." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://openalex\\.org/" ;
            sh:message "An OpenAlex URL starts with https://openalex.org/" ;
            gracia:propertyTemplate ( "https://openalex.org/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "Scopus" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^\\d{6,12}$" ;
            sh:message "A Scopus affiliation id is 6 to 12 digits, like 60030347." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://www\\.scopus\\.com/" ;
            sh:message "A Scopus URL starts with https://www.scopus.com/affil/profile.uri?afid=" ;
            gracia:propertyTemplate ( "https://www.scopus.com/affil/profile.uri?afid={}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "Wikidata" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^Q\\d+$" ;
            sh:message "A Wikidata id is a Q and digits, like Q1065." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://www\\.wikidata\\.org/" ;
            sh:message "A Wikidata URL starts with https://www.wikidata.org/wiki/" ;
            gracia:propertyTemplate ( "https://www.wikidata.org/wiki/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "GRID" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^grid\\.\\d{4,6}\\.[0-9a-f]{1,2}$" ;
            sh:message "A GRID id is like grid.4989.c." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://grid\\.ac/" ;
            sh:message "A GRID URL starts with https://grid.ac/institutes/" ;
            gracia:propertyTemplate ( "https://grid.ac/institutes/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:in ( "Local" "External" ) ] ]
    ) ;

    sh:property [
        sh:path schema:propertyID ;
        sh:name "property ID" ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "ROR" "Local" "External" "OpenAlex" "Scopus" "Wikidata" "GRID" )
    ] ;
    sh:property [
        sh:path schema:value ;
        sh:name "value" ;
        sh:order 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:name "URL" ;
        sh:order 3 ;
        dash:editor dash:URIEditor ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] .

# ============================================================================
# 3. Postal Address Shape
# ============================================================================
ex:PostalAddressShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "geo-alt" ;
    gracia:headerTemplate ( "[{}, ][{} ][{}, ][{}]" schema:streetAddress schema:postalCode schema:addressLocality schema:addressCountry ) ;
    sh:name "Postal address" ;
    sh:class schema:PostalAddress ;

    sh:property [
        sh:path schema:streetAddress ;
        sh:name "street address" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:postalCode ;
        sh:name "postal code" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:addressLocality ;
        sh:name "address locality" ;
        sh:order 3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:addressCountry ;
        sh:name "address country" ;
        sh:order 4 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .