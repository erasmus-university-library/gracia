# The shape of a type record's content: a type is a type too, which makes this a bit meta.
@prefix gracia: <https://gracia.pub/ns/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gracia:TypeShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "diagram-3" ; sh:targetClass gracia:Type ;
    sh:description "A kind of record: its name, the first part of its address, the class of its content and where the files that describe it are." ;
    sh:property [ sh:path gracia:name ; sh:name "Name" ; sh:order 1 ; dash:propertyRole dash:LabelRole ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path gracia:slug ; sh:name "Slug" ; sh:order 2 ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[a-z][a-z0-9-]*$" ] ,
    [ sh:path gracia:class ; sh:name "Class" ; sh:order 3 ;
        sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ,
    [ sh:path gracia:assets ; sh:name "Assets" ; sh:order 4 ;
        sh:description "Where the files of the type are: package:path/" ;
        sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path gracia:schemaTemplate ; sh:name "Schema template" ; sh:order 5 ;
        sh:description "The file in shacl/ its records follow: <Type>-<profile>-<revision>.ttl" ;
        sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:pattern "^[A-Za-z][A-Za-z0-9]*-[a-z][a-z0-9_]*-[0-9]{2,}\\.ttl$" ] ,
    [ sh:path gracia:docTemplate ; sh:name "Doc template" ; sh:order 6 ;
        sh:description "The file in doc/ that makes the doc of a record: doc-<profile>-<revision>.xsl; none: the doc every record has" ;
        sh:datatype xsd:string ; sh:maxCount 1 ;
        sh:pattern "^doc-[a-z][a-z0-9_]*-[0-9]{2,}\\.xsl$" ] .
