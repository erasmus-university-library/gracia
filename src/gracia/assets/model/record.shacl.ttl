@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix gracia: <https://gracia.pub/ns/> .

# What every record has: the shape of the record itself. The content of the record, the blank node
# `gracia:resource` points to, is described by the shape of its type, which is embedded here
# (`sh:node`) when the record shape of a type is made (see `Type.record_shape`).
gracia:RecordShape a sh:NodeShape ;
    sh:targetClass gracia:Record ;
    sh:closed true ; sh:ignoredProperties ( rdf:type ) ;  # nothing else is said of a record
    sh:property
        [ sh:path gracia:resource_uri ; sh:name "Resource URI" ; sh:order 1 ;
          sh:description "The URI the resource is published under (an ORCID, a permanent URI); empty: the ARK of this record" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path gracia:label ; sh:name "Label" ; sh:order 2 ;
          sh:description "A short text for the record, made from its content when it is saved" ;
          sh:datatype xsd:string ; sh:maxCount 1 ] ,
        [ sh:path gracia:slug ; sh:name "Slug" ; sh:order 2.5 ;
          sh:description "The name of the record in its address (john-doe); empty, it is made of the label. A name it had before can be chosen again" ;
          sh:datatype xsd:string ; sh:maxCount 1 ; sh:pattern "^[a-z0-9]+(-[a-z0-9]+)*$" ] ,
        [ sh:path gracia:resource ; sh:name "Content" ; sh:order 3 ;
          sh:nodeKind sh:BlankNode ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path gracia:is_published ; sh:name "Published" ; sh:order 4 ;
          sh:description "Whether the record is published" ;
          sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
        [ sh:path gracia:created_at ; sh:name "Created" ; sh:order 5 ;
          sh:description "When the record was first saved (made when it is saved, shown in the time zone of the repository)" ;
          sh:datatype xsd:dateTime ; sh:maxCount 1 ] ,
        [ sh:path gracia:modified_at ; sh:name "Modified" ; sh:order 6 ;
          sh:description "When the record last changed (made when it is saved, shown in the time zone of the repository)" ;
          sh:datatype xsd:dateTime ; sh:maxCount 1 ] .
