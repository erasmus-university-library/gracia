# The shape of the repository resource: the manage form is generated from it.
@prefix gracia: <https://gracia.pub/ns/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gracia:RepositoryShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "archive" ;
    sh:targetClass gracia:Repository ;
    sh:description "The repository itself: its title, its types, its extensions and where its files are. There is one record of it." ;
    sh:property [
        sh:path gracia:title ; dash:propertyRole dash:LabelRole ; sh:name "Title" ; sh:description "The name of this repository" ;
        sh:order 1 ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1
    ] ,
    [
        sh:path gracia:timezone ; sh:name "Time zone" ;
        sh:description "The time zone that times are shown in (Europe/Amsterdam). Empty: UTC. Everything is stored in UTC" ;
        sh:order 2 ; sh:datatype xsd:string ; sh:maxCount 1
    ] ,
    [
        sh:path gracia:locale ; sh:name "Date format" ;
        sh:description "How dates are shown and typed in the forms (15-03-2024 or 03/15/2024). Empty: ISO 8601 (2024-03-15). They are stored as ISO dates" ;
        sh:order 3 ; sh:datatype xsd:string ; sh:maxCount 1
    ] ,
    [
        sh:path gracia:layoutTemplate ; sh:name "Layout stylesheet" ;
        sh:description "The stylesheet of the page around the pages of the site: the header, the footer. An asset spec (mypackage:skin/layout.xslt) or a path. Empty: the one of gracia" ;
        sh:order 4 ; sh:datatype xsd:string ; sh:maxCount 1
    ] ,
    [
        sh:path gracia:typeTemplate ; sh:name "Type stylesheet" ;
        sh:description "The stylesheet of the page of the records of a type. Empty: the one of gracia" ;
        sh:order 5 ; sh:datatype xsd:string ; sh:maxCount 1
    ] ,
    [
        sh:path gracia:recordTemplate ; sh:name "Record stylesheet" ;
        sh:description "The stylesheet of the page of a record. Empty: the one of gracia" ;
        sh:order 6 ; sh:datatype xsd:string ; sh:maxCount 1
    ] .
