@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix gracia: <https://gracia.pub/ns/> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:     <http://example.org/shapes#> .
@prefix role:   <http://example.org/vocab/role/> .

# ============================================================================
# The classes of a work, as people see them: the name of a choice and of the tab of the
# form, and its icon (a Bootstrap icon)
# ============================================================================
schema:Thesis rdfs:label "Thesis" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "mortarboard" .
schema:ScholarlyArticle rdfs:label "Scholarly article" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "journal-text" .
schema:Article rdfs:label "Article" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "newspaper" .
schema:Book rdfs:label "Book" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "book" .
schema:Report rdfs:label "Report" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "file-earmark-text" .
schema:Dataset rdfs:label "Dataset" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "database" .
schema:SoftwareSourceCode rdfs:label "Software source code" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "code-slash" .
schema:Chapter rdfs:label "Chapter" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "journal-bookmark" .

# ============================================================================
# The roles of a contributor, as people see them: the name and the icon of a choice. What a
# role points at (a person or an organization) is said by the shape of the contributor
# below, and the roles that only some works may have by the shape of the work.
# ============================================================================
role:Contributor rdfs:label "Contributor" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "people" .
role:ThesisSupervisor rdfs:label "Thesis supervisor" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "person-workspace" .
role:CoSupervisor rdfs:label "Co-supervisor" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "person-badge" .
role:ThesisAdvisor rdfs:label "Thesis advisor" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "person-lines-fill" .
role:ExternalReviewer rdfs:label "External reviewer" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "person-check" .
role:Expert rdfs:label "Expert" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "award" .
role:Editor rdfs:label "Editor" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "pencil-square" .
role:Funder rdfs:label "Funder" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "cash-coin" .
role:Sponsor rdfs:label "Sponsor" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "gift" .
role:DegreeGrantor rdfs:label "Degree grantor" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "mortarboard" .

# ============================================================================
# The groups of properties that the form shows in a box of their own (sh:group)
# ============================================================================
ex:HostReferenceGroup a sh:PropertyGroup ;
    rdfs:label "Host Reference" ;
    sh:order 1 .

# ============================================================================
# 1. Scholarly Work / Publication Shape (excludes Series, Collections & Files)
# ============================================================================
ex:CreativeWorkShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "book" ;
    sh:name "Creative work" ;
    sh:targetClass schema:CreativeWork ,
                   schema:Thesis ,
                   schema:ScholarlyArticle ,
                   schema:Article ,
                   schema:Report ,
                   schema:Book ,
                   schema:Chapter ,
                   schema:Dataset ,
                   schema:SoftwareSourceCode ;

    # What kind of work it is: one rdf:type, of the classes below (the form has a choice;
    # schema:CreativeWork, the class of the type, is not one: it has to be said what it is)
    sh:property [
        sh:path rdf:type ;
        sh:name "type" ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( schema:Thesis
                schema:ScholarlyArticle
                schema:Article
                schema:Book
                schema:Report
                schema:Dataset
                schema:SoftwareSourceCode
                schema:Chapter ) ;
        sh:message "A work has one rdf:type: Thesis, ScholarlyArticle, Article, Book, Report, Dataset, SoftwareSourceCode or Chapter."
    ] ;

    # Primary title (required)
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:order 1 ;
        dash:propertyRole dash:LabelRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A work must have exactly one schema:name string."
    ] ;

    # Translated titles or subtitles
    sh:property [
        sh:path schema:alternateName ;
        sh:name "alternate name" ;
        sh:order 2 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        )
    ] ;

    # Abstract (plain or language-tagged strings, in a text area; one for each language)
    sh:property [
        sh:path schema:abstract ;
        sh:name "abstract" ;
        dash:editor dash:TextAreaEditor ;
        sh:order 4 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        )
    ] ;

    # Sub-classification (e.g., MasterThesis, DoctoralThesis, ConferencePaper)
    sh:property [
        sh:path schema:additionalType ;
        sh:name "additional type" ;
        sh:order 6 ;
        sh:nodeKind sh:IRI
    ] ;

    # Authors: a non-empty rdf:list of Person IRIs (schema.org has no lists, but without one
    # the order of the authors is lost); the form fills it in as a list of URIs
    sh:property [
        sh:path schema:author ;
        sh:name "author" ;
        sh:order 7 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        dash:editor gracia:URIListEditor ;
        sh:node ex:PersonUriListShape ;
        sh:not [ sh:hasValue rdf:nil ] ;
        sh:message "schema:author must be a non-empty RDF list of schema:Person IRIs."
    ] ;

    # Contributors: each in a role (schema:Role: a blank node that has the role, and the
    # person or organization it is for as its own schema:contributor)
    sh:property [
        sh:path schema:contributor ;
        sh:name "contributor" ;
        sh:order 8 ;
        sh:nodeKind sh:BlankNode ;
        sh:node ex:ContributorRoleShape ;
        sh:message "schema:contributor on a work must be a blank node of the shape schema:Role."
    ] ;
    sh:property [
        sh:path schema:editor ;
        sh:name "editor" ;
        sh:order 9 ;
        sh:or (
            [ sh:node ex:PersonShape ]
            [ sh:node ex:OrganizationShape ]
        )
    ] ;

    # Degree-granting institution or publisher
    sh:property [
        sh:path schema:publisher ;
        sh:name "publisher" ;
        sh:order 10 ;
        dash:editor dash:URIEditor ;
        sh:node ex:OrganizationShape
    ] ;

    # Publication / defense date
    sh:property [
        sh:path schema:datePublished ;
        sh:name "date published" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:gYear ]
        ) ;
        sh:message "schema:datePublished must be an xsd:date, xsd:gYearMonth, or xsd:gYear."
    ] ;

    # Language & keywords
    sh:property [
        sh:path schema:inLanguage ;
        sh:name "in language" ;
        dash:editor gracia:LanguageEditor ;
        sh:maxCount 1 ;
        sh:order 12 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:keywords ;
        sh:name "keywords" ;
        sh:order 13 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        )
    ] ;

    # Thesis-specific degree level (e.g., "Master of Science", "Doctor of Philosophy")
    sh:property [
        sh:path schema:inSupportOf ;
        sh:name "in support of" ;
        sh:order 19 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;

    # The host reference: the container it was published in (isPartOf, above), and in it the
    # volume and issue (a journal) and the pages (an article or a chapter): one box in the
    # form, the group `Host Reference` (sh:group)
    sh:property [
        sh:path schema:volumeNumber ;
        sh:name "volume" ;
        sh:group ex:HostReferenceGroup ;
        sh:order 15 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:issueNumber ;
        sh:name "issue" ;
        sh:group ex:HostReferenceGroup ;
        sh:order 16 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:pageStart ;
        sh:name "page start" ;
        sh:group ex:HostReferenceGroup ;
        sh:order 17 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:pageEnd ;
        sh:name "page end" ;
        sh:group ex:HostReferenceGroup ;
        sh:order 18 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;

    # Structured identifiers (DOI, ISBN, Handle, OpenAlex, Scopus, a local one, one of another source)
    sh:property [
        sh:path schema:identifier ;
        sh:name "identifier" ;
        sh:order 20 ;
        sh:node ex:PropertyValueShape
    ] ;

    # External authority or persistent resolver URIs
    sh:property [
        sh:path schema:sameAs ;
        sh:name "same as" ;
        sh:order 21 ;
        sh:nodeKind sh:IRI
    ] ;

    # Repository landing page & license
    sh:property [
        sh:path schema:url ;
        sh:name "URL" ;
        sh:order 22 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path schema:license ;
        sh:name "license" ;
        sh:order 23 ;
        sh:nodeKind sh:IRI
    ] ;

    # Containers: Collections, Series/Periodicals directly, Volumes, or Issues (blank nodes or IRIs)
    sh:property [
        sh:path schema:isPartOf ;
        sh:name "is part of" ;
        sh:group ex:HostReferenceGroup ;
        sh:order 14 ;
        dash:editor dash:URIEditor ;
        sh:or (
            [ sh:node ex:CollectionShape ]
            [ sh:node ex:CreativeWorkSeriesShape ]
            [ sh:node ex:PublicationVolumeShape ]
            [ sh:node ex:PublicationIssueShape ]
        ) ;
        sh:message "schema:isPartOf must reference a valid Collection, Series/Periodical, PublicationVolume, or PublicationIssue."
    ] ;

    # Attached files (PDFs, datasets, supplements)
    sh:property [
        sh:path schema:encoding ;
        sh:name "encoding" ;
        sh:order 24 ;
        sh:node ex:MediaObjectShape
    ] .

# ============================================================================
# 1a. What only a thesis has. A rule is "the work is of the class, or it has none of these"
# (sh:or). It is a shape of its own that has the same works as the work has (their classes), so
# that what is wrong is said in its own words. The form leaves what a rule is about out of the
# menu or the form of the other works, and a record that has it as another work is refused
# here.
# ============================================================================
ex:ThesisRolesShape a sh:NodeShape ;
    sh:name "Roles of a thesis" ;
    sh:targetClass schema:Thesis , schema:ScholarlyArticle , schema:Article , schema:Book ,
                   schema:Report , schema:Dataset , schema:SoftwareSourceCode , schema:Chapter ;
    sh:or (
        [ sh:property [ sh:path rdf:type ; sh:hasValue schema:Thesis ] ]
        [ sh:property [ sh:path ( schema:contributor schema:roleName ) ;
                        sh:not [ sh:in ( role:ThesisSupervisor role:CoSupervisor
                                         role:ThesisAdvisor role:DegreeGrantor ) ] ] ]
    ) ;
    sh:message "The roles Thesis supervisor, Co-supervisor, Thesis advisor and Degree grantor are only for a thesis." .

ex:ThesisFieldsShape a sh:NodeShape ;
    sh:name "Fields of a thesis" ;
    sh:targetClass schema:Thesis , schema:ScholarlyArticle , schema:Article , schema:Book ,
                   schema:Report , schema:Dataset , schema:SoftwareSourceCode , schema:Chapter ;
    sh:or (
        [ sh:property [ sh:path rdf:type ; sh:hasValue schema:Thesis ] ]
        [ sh:property [ sh:path schema:inSupportOf ; sh:maxCount 0 ] ]
    ) ;
    sh:message "In support of is only for a thesis." .

# ============================================================================
# 1b. A list of Person IRIs (an rdf:list: rdf:nil, or an item and the rest of the list)
# ============================================================================
ex:PersonUriListShape a sh:NodeShape ;
    sh:name "List of person URIs" ;
    sh:or (
        # the end of the list
        [ sh:nodeKind sh:IRI ; sh:hasValue rdf:nil ]
        # an item: rdf:first is a Person IRI, rdf:rest is a list
        [
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:property [
                sh:path rdf:first ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:nodeKind sh:IRI ;
                sh:node ex:PersonShape ;
                sh:message "Each item in the author list must be a Person IRI."
            ] ;
            sh:property [
                sh:path rdf:rest ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:node ex:PersonUriListShape ;
                sh:message "rdf:rest must be an RDF list."
            ]
        ]
    ) .

# ============================================================================
# 1c. A contributor in a role (schema:Role): the role, and the person or organization
# ============================================================================
ex:ContributorRoleShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "people" ;
    gracia:headerTemplate ( "{}" schema:contributor ) ;
    gracia:headerAddOnTemplate ( "{}" schema:roleName ) ;
    sh:name "Contributor role" ;
    sh:class schema:Role ;

    sh:property [
        sh:path schema:roleName ;
        sh:name "role" ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:defaultValue role:Contributor ;
        sh:in ( role:Contributor
                role:ThesisSupervisor
                role:CoSupervisor
                role:ThesisAdvisor
                role:ExternalReviewer
                role:Expert
                role:Editor
                role:Funder
                role:Sponsor
                role:DegreeGrantor ) ;
        sh:message "schema:Role must have a valid schema:roleName."
    ] ;

    # The inner schema:contributor is the IRI of the person or organization it is for
    sh:property [
        sh:path schema:contributor ;
        sh:name "contributor" ;
        sh:order 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        dash:editor dash:URIEditor ;
        sh:message "The inner schema:contributor of a schema:Role must be the IRI of a person or an organization."
    ] ;

    # Which of the two it is follows the role: a funder, a sponsor and a degree grantor are
    # organizations, the roles of people are people, and a contributor, with no more said, is
    # either. The form looks for the one or the other by the role that is chosen (a new node
    # has the role Contributor, sh:defaultValue).
    sh:or (
        [ sh:property [ sh:path schema:roleName ; sh:hasValue role:Contributor ] ;
          sh:property [ sh:path schema:contributor ;
                        sh:or ( [ sh:node ex:PersonShape ] [ sh:node ex:OrganizationShape ] ) ] ]
        [ sh:property [ sh:path schema:roleName ;
                        sh:in ( role:ThesisSupervisor role:CoSupervisor role:ThesisAdvisor
                                role:ExternalReviewer role:Expert role:Editor ) ] ;
          sh:property [ sh:path schema:contributor ; sh:node ex:PersonShape ] ]
        [ sh:property [ sh:path schema:roleName ;
                        sh:in ( role:Funder role:Sponsor role:DegreeGrantor ) ] ;
          sh:property [ sh:path schema:contributor ; sh:node ex:OrganizationShape ] ]
    ) .

# ============================================================================
# 2. PublicationVolume Shape (supports both Blank Nodes and Named IRIs)
# ============================================================================
ex:PublicationVolumeShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "journal-bookmark" ;
    gracia:headerTemplate ( "[Volume {}]" schema:volumeNumber ) ;
    sh:name "Publication volume" ;
    sh:targetClass schema:PublicationVolume ;
    sh:class schema:PublicationVolume ;

    sh:property [
        sh:path schema:volumeNumber ;
        sh:name "volume number" ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A PublicationVolume must have exactly one schema:volumeNumber string."
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:datePublished ;
        sh:name "date published" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:gYear ]
        )
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:name "identifier" ;
        sh:order 5 ;
        sh:node ex:PropertyValueShape
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:name "URL" ;
        sh:order 6 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path schema:isPartOf ;
        sh:name "is part of" ;
        sh:order 4 ;
        sh:minCount 1 ;
        sh:node ex:CreativeWorkSeriesShape ;
        sh:message "A PublicationVolume must link to its parent Periodical/Series via schema:isPartOf."
    ] .

# ============================================================================
# 3. PublicationIssue Shape (supports both Blank Nodes and Named IRIs)
# ============================================================================
ex:PublicationIssueShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "journal-text" ;
    gracia:headerTemplate ( "[Issue {}]" schema:issueNumber ) ;
    sh:name "Publication issue" ;
    sh:targetClass schema:PublicationIssue ;
    sh:class schema:PublicationIssue ;

    sh:property [
        sh:path schema:issueNumber ;
        sh:name "issue number" ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A PublicationIssue must have exactly one schema:issueNumber string."
    ] ;
    # Useful for special issue titles (e.g., "Special Issue on Semantic Repositories")
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:datePublished ;
        sh:name "date published" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYearMonth ]
            [ sh:datatype xsd:gYear ]
        )
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:name "identifier" ;
        sh:order 5 ;
        sh:node ex:PropertyValueShape
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:name "URL" ;
        sh:order 6 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    # Can link upward to a PublicationVolume blank node OR directly to a Periodical/Series
    sh:property [
        sh:path schema:isPartOf ;
        sh:name "is part of" ;
        sh:order 4 ;
        sh:minCount 1 ;
        sh:or (
            [ sh:node ex:PublicationVolumeShape ]
            [ sh:node ex:CreativeWorkSeriesShape ]
        ) ;
        sh:message "A PublicationIssue must link to a PublicationVolume or directly to a Periodical/Series."
    ] .

# ============================================================================
# 4. File / PDF Attachment Shape (schema:MediaObject)
# ============================================================================
ex:MediaObjectShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "file-earmark-play" ;
    gracia:headerTemplate ( "{}" schema:name ) ;
    gracia:headerAddOnTemplate ( "{}" schema:encodingFormat ) ;
    sh:name "Media object" ;
    sh:class schema:MediaObject ;

    sh:property [
        sh:path schema:contentUrl ;
        sh:name "content URL" ;
        sh:order 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path schema:encodingFormat ;
        sh:name "encoding format" ;
        sh:order 3 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:contentSize ;
        sh:name "content size" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .

# ============================================================================
# 2. Structured Identifier Shape (schema:PropertyValue)
# ============================================================================
ex:PropertyValueShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "fingerprint" ;
    gracia:headerTemplate ( "{}" schema:value ) ;
    gracia:headerAddOnTemplate ( "{}" schema:propertyID ) ;
    sh:name "Property value" ;
    sh:class schema:PropertyValue ;

    # the kinds of identifier, and what the value of each looks like (the other kinds, a
    # local one and one of some other source, can be anything)
    sh:message "The value is not in the form of its kind: DOI 10.1000/xyz123, ISBN 10 or 13 digits, Handle 20.500.1234/5678, OpenAlex W2741809807, Scopus 2-s2.0-85012345678" ;
    sh:or (
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "DOI" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^10\\.\\d{4,9}/\\S+$" ;
            sh:message "A DOI starts with 10. and a registrant number, a slash and a name, like 10.1000/xyz123." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://doi\\.org/" ;
            sh:message "A DOI URL starts with https://doi.org/" ;
            gracia:propertyTemplate ( "https://doi.org/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "ISBN" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^(?:\\d-?){9}[\\dXx]$|^97[89](?:-?\\d){10}$" ;
            sh:message "An ISBN is 10 digits (the last may be X) or 13 digits that start with 978 or 979, with or without hyphens, like 978-3-16-148410-0." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^urn:isbn:" ;
            sh:message "An ISBN URL starts with urn:isbn:" ;
            gracia:propertyTemplate ( "urn:isbn:{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "Handle" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^\\d+(?:\\.\\d+)*/\\S+$" ;
            sh:message "A Handle is a prefix of digits and dots, a slash and a name, like 20.500.1234/5678." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://hdl\\.handle\\.net/" ;
            sh:message "A Handle URL starts with https://hdl.handle.net/" ;
            gracia:propertyTemplate ( "https://hdl.handle.net/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "OpenAlex" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^W\\d+$" ;
            sh:message "An OpenAlex work id is a W and digits, like W2741809807." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://openalex\\.org/" ;
            sh:message "An OpenAlex URL starts with https://openalex.org/" ;
            gracia:propertyTemplate ( "https://openalex.org/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "Scopus" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^2-s2\\.0-\\d{6,12}$" ;
            sh:message "A Scopus EID is 2-s2.0- and 6 to 12 digits, like 2-s2.0-85012345678." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://www\\.scopus\\.com/" ;
            sh:message "A Scopus URL starts with https://www.scopus.com/record/display.uri?eid=" ;
            gracia:propertyTemplate ( "https://www.scopus.com/record/display.uri?eid={}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:in ( "Local" "External" ) ] ]
    ) ;

    # The kind of identifier
    sh:property [
        sh:path schema:propertyID ;
        sh:name "property ID" ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "DOI" "ISBN" "Handle" "OpenAlex" "Scopus" "Local" "External" ) ;
        sh:message "A PropertyValue identifier must have exactly one schema:propertyID string."
    ] ;

    # The identifier value itself
    sh:property [
        sh:path schema:value ;
        sh:name "value" ;
        sh:order 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A PropertyValue identifier must have exactly one schema:value string."
    ] ;

    # Optional resolvable URI for the identifier
    sh:property [
        sh:path schema:url ;
