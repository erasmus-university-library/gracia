@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix gracia: <https://gracia.pub/ns/> .
@prefix dash:   <http://datashapes.org/dash#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:     <http://example.org/shapes#> .

# ============================================================================
# The classes of a series, as people see them: the name of a choice and of the tab of the
# form, and its icon (a Bootstrap icon)
# ============================================================================
schema:Periodical rdfs:label "Periodical" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "journals" .
schema:Newspaper rdfs:label "Newspaper" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "newspaper" .
schema:BookSeries rdfs:label "Book series" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "bookshelf" .
schema:CreativeWorkSeries rdfs:label "Series" ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "collection" .

# ============================================================================
# 1. CreativeWorkSeries Shape (covers CreativeWorkSeries & bibliographic subtypes)
# ============================================================================
ex:CreativeWorkSeriesShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "journals" ;
    sh:name "Creative work series" ;
    sh:targetClass schema:CreativeWorkSeries ,
                   schema:Periodical ,
                   schema:BookSeries ,
                   schema:Newspaper ;

    # What kind of series it is: one rdf:type, of the classes above (the form has a choice;
    # schema:CreativeWorkSeries, the class of the type, is the one it starts with)
    sh:property [
        sh:path rdf:type ;
        sh:name "type" ;
        sh:order 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( schema:Periodical
                schema:Newspaper
                schema:BookSeries
                schema:CreativeWorkSeries ) ;
        sh:message "A series has one rdf:type: Periodical, Newspaper, BookSeries or CreativeWorkSeries."
    ] ;

    # Series / Journal title (required)
    sh:property [
        sh:path schema:name ;
        sh:name "name" ;
        sh:order 1 ;
        dash:propertyRole dash:LabelRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A series must have exactly one schema:name string."
    ] ;

    # Short abbreviations (xsd:string) and translated titles (rdf:langString)
    sh:property [
        sh:path schema:alternateName ;
        sh:name "alternate name" ;
        sh:order 2 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
        sh:message "schema:alternateName must be a plain string or a language-tagged string."
    ] ;

    # Scope / description (supports plain strings and language-tagged strings)
    sh:property [
        sh:path schema:description ;
        sh:name "description" ;
        dash:editor dash:TextAreaEditor ;
        sh:maxCount 1 ;
        sh:order 3 ;
        sh:or (
            [ sh:datatype xsd:string ]
            [ sh:datatype rdf:langString ]
        ) ;
        sh:message "schema:description must be a plain string or a language-tagged string."
    ] ;

    # Optional sub-classification (e.g., ThesisSeries, ProceedingsSeries)
    sh:property [
        sh:path schema:additionalType ;
        sh:name "additional type" ;
        sh:order 4 ;
        sh:nodeKind sh:IRI ;
        sh:message "schema:additionalType must be a concept IRI."
    ] ;

    # Series run dates
    sh:property [
        sh:path schema:startDate ;
        sh:name "start date" ;
        sh:order 6 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYear ]
        ) ;
        sh:message "schema:startDate must be an xsd:date or xsd:gYear."
    ] ;
    sh:property [
        sh:path schema:endDate ;
        sh:name "end date" ;
        sh:order 7 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:gYear ]
        ) ;
        sh:message "schema:endDate must be an xsd:date or xsd:gYear."
    ] ;

    # Structured identifiers (ISSN, ISBN, OpenAlex, a local one, one of another source)
    sh:property [
        sh:path schema:identifier ;
        sh:name "identifier" ;
        sh:order 12 ;
        sh:node ex:PropertyValueShape ;
        sh:message "schema:identifier must be a valid schema:PropertyValue node."
    ] ;

    # External authority URIs (ISSN Portal, Wikidata, etc.)
    sh:property [
        sh:path schema:sameAs ;
        sh:name "same as" ;
        sh:order 13 ;
        sh:nodeKind sh:IRI ;
        sh:message "schema:sameAs must be a valid IRI."
    ] ;

    # Series homepage
    sh:property [
        sh:path schema:url ;
        sh:name "URL" ;
        sh:order 11 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;

    # Primary publication language(s)
    sh:property [
        sh:path schema:inLanguage ;
        sh:name "in language" ;
        dash:editor gracia:LanguageEditor ;
        sh:maxCount 1 ;
        sh:order 8 ;
        sh:datatype xsd:string
    ] ;

    # Default license URI
    sh:property [
        sh:path schema:license ;
        sh:name "license" ;
        sh:order 9 ;
        sh:nodeKind sh:IRI
    ] ;

    # Publishing organization
    sh:property [
        sh:path schema:publisher ;
        sh:name "publisher" ;
        sh:order 10 ;
        dash:editor dash:URIEditor ;
        sh:node ex:OrganizationShape ;
        sh:message "schema:publisher must be a valid schema:Organization node."
    ] .

# ============================================================================
# 2. Structured Identifier Shape (schema:PropertyValue)
# ============================================================================
ex:PropertyValueShape a sh:NodeShape ;
    dash:propertyRole dash:IconRole ; sh:defaultValue "fingerprint" ;
    gracia:headerTemplate ( "{}" schema:value ) ;
    gracia:headerAddOnTemplate ( "{}" schema:propertyID ) ;
    sh:name "Property value" ;
    sh:class schema:PropertyValue ;

    # the kinds of identifier, and what the value of each looks like (the other kinds, a
    # local one and one of some other source, can be anything)
    sh:message "The value is not in the form of its kind: ISSN 0302-9743, ISBN 10 or 13 digits, OpenAlex S4210172589" ;
    sh:or (
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "ISSN" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^\\d{4}-\\d{3}[\\dX]$" ;
            sh:message "An ISSN is two groups of four digits (the last may be X), like 0302-9743." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^urn:issn:" ;
            sh:message "An ISSN URL starts with urn:issn:" ;
            gracia:propertyTemplate ( "urn:issn:{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "ISBN" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^(?:\\d-?){9}[\\dXx]$|^97[89](?:-?\\d){10}$" ;
            sh:message "An ISBN is 10 digits (the last may be X) or 13 digits that start with 978 or 979, with or without hyphens, like 978-3-16-148410-0." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^urn:isbn:" ;
            sh:message "An ISBN URL starts with urn:isbn:" ;
            gracia:propertyTemplate ( "urn:isbn:{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:hasValue "OpenAlex" ] ;
          sh:property [ sh:path schema:value ; sh:pattern "^S\\d+$" ;
            sh:message "An OpenAlex source id is an S and digits, like S4210172589." ] ;
          sh:property [ sh:path schema:url ; sh:pattern "^https://openalex\\.org/" ;
            sh:message "An OpenAlex URL starts with https://openalex.org/" ;
            gracia:propertyTemplate ( "https://openalex.org/{}" schema:value ) ] ]
        [ sh:property [ sh:path schema:propertyID ; sh:in ( "Local" "External" ) ] ]
    ) ;

    # The kind of identifier
    sh:property [
        sh:path schema:propertyID ;
        sh:name "property ID" ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "ISSN" "ISBN" "OpenAlex" "Local" "External" ) ;
        sh:message "A PropertyValue identifier must have exactly one schema:propertyID string."
    ] ;

    # The identifier value itself
    sh:property [
        sh:path schema:value ;
        sh:name "value" ;
        sh:order 2 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A PropertyValue identifier must have exactly one schema:value string."
    ] ;

    # Optional resolvable URI for the identifier
    sh:property [
        sh:path schema:url ;
        sh:name "URL" ;
        sh:order 3 ;
        dash:editor dash:URIEditor ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] .
