<!DOCTYPE html>
<!-- The bare log of a job, for the iframe in the job panel: no layout, the log fills the frame and
     scrolls. The script is the same as on the log page, with its controls hidden. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${heading}</title>
</head>
<body style="margin: 0">
  <div data-job-log="" data-log-url="${log_url}" data-status-url="${status_url}">
    <select hidden="hidden" data-log-name=""><option value="${name}" selected="selected">${name}</option></select>
    <span hidden="hidden" data-log-state=""></span>
    <input type="checkbox" hidden="hidden" checked="checked" data-log-follow="">
    <pre style="margin: 0; padding: .4rem; height: 100vh; box-sizing: border-box; overflow: auto;
                font-size: .75rem; line-height: 1.25; background: #f8f9fa" data-log-text=""></pre>
  </div>
</body>
</html>
