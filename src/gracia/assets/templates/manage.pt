<html metal:use-macro="layout.macros['layout']">
  <metal:slot fill-slot="header">
    <h1 class="h3 mb-0">${heading}</h1>
    <div class="text-muted">${subtitle}</div>
  </metal:slot>

  <metal:slot fill-slot="content">
    <!-- a tab is a named form (gracia.views.tabs); its pane is what the tab renders -->
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item" role="presentation" tal:repeat="pane panes">
        <button type="button" class="nav-link${' active' if pane['active'] else ''}"
                data-bs-toggle="tab" data-bs-target="#tab-${pane['name']}" data-tab="${pane['name']}"
                role="tab" aria-selected="${'true' if pane['active'] else 'false'}">${pane['title']}</button>
      </li>
    </ul>
    <div class="tab-content pt-3">
      <div class="tab-pane${' active' if pane['active'] else ''}" id="tab-${pane['name']}"
           role="tabpanel" tal:repeat="pane panes">
        <div tal:replace="structure pane['html']">the tab</div>
      </div>
    </div>
  </metal:slot>
</html>
