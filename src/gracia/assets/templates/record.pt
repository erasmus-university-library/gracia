<!-- A record for a person (`views.type.record_page`): its label, its type, the description when the
     shape of the type has one, and a table of its key information, each property under the name the
     shape gives it. -->
<html metal:use-macro="layout.macros['layout']">
  <metal:slot fill-slot="header">
    <h1 class="h3 mb-0">${heading}</h1>
    <div class="text-muted"><a href="${type_url}">${type_name}</a></div>
  </metal:slot>
  <metal:slot fill-slot="content">
    <div class="d-flex justify-content-end gap-2 mb-3" tal:condition="edit_url">
      <a class="btn btn-outline-secondary btn-sm" href="${edit_url}">Edit</a>
    </div>
    <p tal:repeat="paragraph description" class="lead">${paragraph}</p>
    <table class="table" tal:condition="rows">
      <tbody>
        <tr tal:repeat="row rows">
          <th scope="row" class="w-25">${row['name']}</th>
          <td>
            <div tal:repeat="value row['values']">
              <a href="${value['url']}" tal:condition="value['url']">${value['text']}</a>
              <span tal:condition="not value['url']">${value['text']}</span>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
    <p class="small text-muted"><code>${uri}</code></p>
  </metal:slot>
</html>
