<!-- The Jobs tab of the manage page of a type: the jobs that are about its records, each with a
     Start button (it posts the fields of its own form to the jobs node, see static/scripts/jobs.js),
     and the table of the jobs of this type with the dialog that follows one. -->
<div tal:omit-tag="">
  <div class="alert alert-danger d-none" id="type-jobs-problem" role="alert"></div>
  <div class="list-group mb-4">
    <form tal:repeat="item jobs" id="type-job-${item['name']}"
          class="list-group-item d-flex flex-wrap align-items-center gap-3">
      <div class="flex-grow-1">
        <div class="fw-semibold">${item['title']}</div>
        <div class="small text-muted">${item['description']}</div>
      </div>
      <input type="hidden" name="res_type" value="${res_type}" />
      <select tal:condition="item['schemas']" name="schema" class="form-select w-auto"
              aria-label="Schema">
        <option tal:repeat="option item['schemas']" value="${option[0]}">${option[1]}</option>
      </select>
      <button type="button" class="btn btn-outline-primary" data-start-job="${item['url']}"
              data-start-fields="${item['fields']}" data-start-error="#type-jobs-problem">Start</button>
    </form>
    <div tal:condition="not jobs" class="list-group-item text-muted">
      You may not start any job here.
    </div>
  </div>
  <div tal:define="panel load: job_panel.pt; panel_list_url string:${list_url}; panel_watch string:; panel_compact string:;
                   panel_filter string:subject=${res_type}"
       tal:condition="can_list"
       metal:use-macro="panel.macros['panel']"></div>
</div>
