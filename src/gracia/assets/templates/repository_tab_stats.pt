<!-- The Stats tab of the manage page of a repository: two fieldsets, the caches (what is kept for this repository)
     and the pending actions (what waits for the worker that follows the writes). The types have their own tab
     and the search indexes theirs. A button of each starts the job that does the work (the panel of the Jobs
     tab, which is on the page, follows it). The numbers are those of the moment the page was made. -->
<div>
  <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">The numbers are those of the moment this page was made.</span>
    <a href="${refresh_url}" class="btn btn-outline-secondary btn-sm" id="stats-refresh">Refresh</a>
  </div>
  <div class="alert alert-danger d-none" id="stats-jobs-problem" role="alert"></div>

  <fieldset class="mb-4" id="stats-cache">
    <legend class="h5">Cache</legend>
    <dl class="row mb-2">
      <dt class="col-sm-4">Records with an etag</dt>
      <dd class="col-sm-8" id="stats-pages">${'{:,}'.format(cache['pages'])}
        <span class="text-muted" tal:condition="cache['missing']">
          (${'{:,}'.format(cache['missing'])} without one: <em>Rebuild etags</em> makes them)</span></dd>
      <dt class="col-sm-4">Size of what the pages are made of</dt>
      <dd class="col-sm-8">${cache['pages_size']}
        <span class="text-muted">(a record in many pages counts in each)</span></dd>
      <dt class="col-sm-4">Latest change of a page</dt><dd class="col-sm-8">${cache['modified']}</dd>
      <dt class="col-sm-4">Repository last written</dt>
      <dd class="col-sm-8" id="stats-written">${cache['written']}
        <span class="text-muted" tal:condition="cache['age']">(${cache['age']} ago: what the caches
          below keep is of this time; after a write it is dropped and made again as it is asked for)</span></dd>
    </dl>
    <table class="table table-sm align-middle mb-3" id="stats-kept">
      <caption class="small text-muted caption-top">Kept for this repository</caption>
      <thead>
        <tr><th>Cache</th><th class="text-end">Entries</th><th class="text-end">Old</th>
            <th class="text-end">Size</th></tr>
      </thead>
      <tbody>
        <tr tal:repeat="row cache['kept']" id="stats-kept-${row['name']}">
          <td><code>${row['name']}</code></td>
          <tal:kept condition="row['kept']">
            <td class="text-end">${row['entries']}</td>
            <td class="text-end">${row['stale']}</td>
            <td class="text-end">${row['bytes']}</td>
          </tal:kept>
          <td colspan="3" class="text-muted" tal:condition="not row['kept']">
            no cache: set <code>gracia.cache_dir</code></td>
        </tr>
      </tbody>
    </table>
    <form id="stats-job-update_cache" tal:condition="'update_cache' in buttons" class="mb-0">
      <button type="button" class="btn btn-outline-primary btn-sm" data-start-fields=""
              data-start-job="${buttons['update_cache']['url']}"
              data-start-error="#stats-jobs-problem">${buttons['update_cache']['title']}</button>
      <span class="small text-muted ms-2">makes the graph of every record again</span>
    </form>
  </fieldset>

  <fieldset class="mb-4" id="stats-actions">
    <legend class="h5">Pending actions</legend>
    <dl class="row mb-2">
      <dt class="col-sm-4">Worker</dt>
      <dd class="col-sm-8" id="stats-worker" data-state="${actions['worker']['state']}">
        <span class="badge ${'text-bg-success' if actions['worker']['ok'] else 'text-bg-secondary'} me-1">${actions['worker']['state']}</span>
        ${actions['worker']['text']}</dd>
      <dt class="col-sm-4">Waiting</dt>
      <dd class="col-sm-8" id="stats-pending">${'{:,}'.format(actions['records'])}
        ${'record' if actions['records'] == 1 else 'records'}
        <span class="text-muted" tal:condition="actions['rows']">
          (${'{:,}'.format(actions['rows'])} ${'row' if actions['rows'] == 1 else 'rows'}:
          ${actions['by_action']}; ${actions['size']} of sources)</span></dd>
      <dt class="col-sm-4" tal:condition="actions['since']">Oldest</dt>
      <dd class="col-sm-8" tal:condition="actions['since']">${actions['since']}
        <span class="text-muted">(transaction ${actions['oldest']} of ${actions['last']})</span></dd>
    </dl>
    <form id="stats-job-process_actions" tal:condition="'process_actions' in buttons" class="mb-0">
      <button type="button" class="btn btn-outline-primary btn-sm" data-start-fields=""
              data-start-job="${buttons['process_actions']['url']}"
              data-start-error="#stats-jobs-problem">${buttons['process_actions']['title']}</button>
      <span class="small text-muted ms-2">hands what waits to what follows the data</span>
    </form>
  </fieldset>

  <!-- the dialog that follows a job started from this tab (no table: the Jobs tab has that) -->
  <div tal:condition="can_list" id="stats-job-dialog"
       tal:define="panel_list_url string:${list_url}; panel_watch string:; panel_compact string:true;
                   panel_filter string:job=update_cache,process_actions"
       metal:use-macro="panel.macros['panel']"></div>
</div>
