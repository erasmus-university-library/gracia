<!-- The page of a repository for a browser: a search box and what the search index finds. A first look,
     kept small on purpose (views/repository.py, `search_page`). -->
<html metal:use-macro="layout.macros['layout']">
  <metal:slot fill-slot="header">
    <h1 class="h3 mb-0">${heading}</h1>
    <div class="text-muted">${subtitle}</div>
  </metal:slot>

  <metal:slot fill-slot="content">
    <form method="get" action="${action}" class="mb-4" role="search">
      <div class="input-group input-group-lg">
        <input type="search" name="q" value="${query}" class="form-control" id="search-q"
               placeholder="Search the records" autofocus aria-label="Search the records">
        <button type="submit" class="btn btn-primary">Search</button>
      </div>
    </form>

    <p class="text-muted" id="search-message" tal:condition="message">${message}</p>

    <p class="text-muted small" id="search-count" tal:condition="hits">
      ${shown} of ${total} ${'record' if total == 1 else 'records'} found.</p>
    <ul class="list-group" id="search-hits" tal:condition="hits">
      <li class="list-group-item d-flex justify-content-between align-items-center" tal:repeat="hit hits">
        <span>
          <a href="${hit['url']}" tal:omit-tag="not hit['url']">${hit['label']}</a>
          <span class="badge text-bg-warning ms-1" tal:condition="not hit['published']">not published</span>
        </span>
        <span class="text-muted small"><span class="badge text-bg-secondary me-2">${hit['type']}</span><code>${hit['record']}</code></span>
      </li>
    </ul>
  </metal:slot>
</html>
