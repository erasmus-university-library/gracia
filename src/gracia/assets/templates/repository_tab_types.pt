<!-- The Types tab of the manage page of a repository: a row for each type that is installed (and for one that has
     records and is not): what the shape of the type says of it, its slug, how many records it has (and
     how many are published), their size and when one of them last changed. A row is a link to the manage
     page of the type, for those who may manage it. -->
<div>
  <table class="table table-sm table-hover align-middle" id="types-table" tal:condition="types">
    <thead>
      <tr><th>Type</th><th>Slug</th><th class="text-end">Records</th><th class="text-end">Published</th>
          <th class="text-end">Size</th><th class="text-end">Average</th><th>Last modified</th></tr>
    </thead>
    <tbody>
      <tr tal:repeat="t types" id="type-${t['slug']}" class="position-relative">
        <td>
          <a tal:condition="t['url']" href="${t['url']}" class="stretched-link text-decoration-none fw-semibold">${t['name']}</a>
          <span tal:condition="not t['url']" class="fw-semibold">${t['name']}</span>
          <span class="badge text-bg-secondary ms-1" tal:condition="t['system']">system</span>
          <div class="small text-muted" tal:condition="t['description']">${t['description']}</div>
        </td>
        <td><code>${t['slug']}</code></td>
        <td class="text-end">${t['records']}</td>
        <td class="text-end">${t['published']}</td>
        <td class="text-end">${t['size']}</td>
        <td class="text-end">${t['average']}</td>
        <td>${t['modified']}</td>
      </tr>
    </tbody>
    <tfoot>
      <tr class="fw-semibold" id="types-total">
        <td>All</td><td></td><td class="text-end">${totals['records']}</td><td></td>
        <td class="text-end">${totals['size']}</td><td></td><td>${totals['modified']}</td>
      </tr>
    </tfoot>
  </table>
  <p class="text-muted" tal:condition="not types">No types are installed.</p>
</div>
