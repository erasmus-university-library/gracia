<!-- The form of gracia.forms.Form(tabs=...): deform's form.pt with the fields on tabs. Every field
     that is a mapping is a tab of its own, the loose fields are on the last one. A tab that has an
     error is the one that is open, and is marked. -->
<form
  tal:define="item_template item_template|field.widget.item_template;
              css_class css_class|string:${field.widget.css_class or field.css_class or ''};
              formid formid|field.formid;
              action action|field.action or None;
              method field.method;
              buttons field.buttons;
              tabs python:field.widget.tabs(field, cstruct)"
  tal:attributes="class css_class; action action"
  id="${formid}"
  novalidate="novalidate"
  method="${method}"
  enctype="multipart/form-data"
  accept-charset="utf-8"
  i18n:domain="deform">

  <fieldset class="deform-form-fieldset">

    <input type="hidden" name="_charset_" />
    <input type="hidden" name="__formid__" value="${formid}"/>

    <div class="alert alert-danger" tal:condition="field.error">
      <div class="error-msg-lbl" i18n:translate="">There was a problem with your submission</div>
      <div class="error-msg-detail" i18n:translate="">Errors have been highlighted below</div>
      <p class="error-msg">${field.errormsg}</p>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
      <li class="nav-item" role="presentation" tal:repeat="tab tabs">
        <button type="button" class="nav-link${' active' if tab.active else ''}"
                data-bs-toggle="tab" data-bs-target="#${tab.id}" role="tab"
                id="${tab.id}-tab" aria-controls="${tab.id}"
                aria-selected="${'true' if tab.active else 'false'}"><i tal:condition="tab.icon"
                   class="bi bi-${tab.icon} me-1" aria-hidden="true"></i><span class="tab-title">${tab.title}</span><span
                tal:condition="tab.error" class="text-danger" title="This tab has an error"> ●</span></button>
      </li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane${' active' if tab.active else ''}" id="${tab.id}" role="tabpanel"
           aria-labelledby="${tab.id}-tab"
           tal:attributes="data-only-for-fields tab.only_for if tab.only_for != '{}' else None"
           tal:repeat="tab tabs">
        <tal:mapping tal:condition="tab.mapping is not None">
          <div class="alert alert-danger" tal:condition="tab.mapping.errormsg">${tab.mapping.errormsg}</div>
          ${structure: tab.mapping.start_mapping()}
          <!-- the fields that are in a group (sh:group) next to each other are in a box of their own -->
          <tal:run tal:repeat="run field.widget.runs(tab.mapping.children)">
            <!-- A group of fields (sh:group): its name is in the column of the labels, as the label of a
                 field is, and the fields are in a box in the column of the inputs, which has a column of
                 labels of its own (a card-body, as a subform has) -->
            <div tal:condition="run.group" class="mb-3 field-group" role="group"
                 aria-labelledby="${tab.id}-group-${repeat.run.index}">
              <label class="form-label" id="${tab.id}-group-${repeat.run.index}">${run.group}</label>
              <div class="field-group-box card-body border rounded p-3 pb-1">
                <div tal:repeat="child run.fields"
                     tal:replace="structure child.render_template(item_template)"/>
              </div>
            </div>
            <!-- /field-group -->
            <tal:plain tal:condition="not run.group">
              <div tal:repeat="child run.fields"
                   tal:replace="structure child.render_template(item_template)"/>
            </tal:plain>
          </tal:run>
          ${structure: tab.mapping.end_mapping()}
        </tal:mapping>
        <tal:loose tal:condition="tab.mapping is None">
          <div tal:repeat="child tab.fields"
               tal:replace="structure child.render_template(item_template)"/>
        </tal:loose>
      </div>
    </div>

    <div class="mb-3 deform-form-buttons">
      <tal:loop tal:repeat="button buttons">
        <button id="${formid+button.name}" name="${button.name}" type="${button.type}"
                class="btn ${button.css_class or ('btn-primary' if repeat.button.start else 'btn-secondary')}"
                value="${button.value}" tal:condition="button.type != 'link'"><i
                  tal:condition="button.name == 'save'" class="bi bi-floppy me-1" aria-hidden="true"></i>${button.title}</button>
        <a id="${formid+button.name}" class="btn ${button.css_class or 'btn-secondary'}"
           href="${button.value}" tal:condition="button.type == 'link'">${button.title}</a>
      </tal:loop>
    </div>

  </fieldset>
</form>
