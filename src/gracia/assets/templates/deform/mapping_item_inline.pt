<div class="${field.widget.item_css_class or ''}"
     id="item-${field.oid}"
     title="${field.description}">
  <span tal:replace="structure field.serialize(cstruct).strip()"/>
  <p class="form-text text-danger mb-0"
     tal:define="errstr 'error-%s' % field.oid"
     tal:repeat="msg field.error.messages()"
     tal:attributes="id repeat.msg.index==0 and errstr or ('%s-%s' % (errstr, repeat.msg.index))"
     tal:condition="field.error and not field.widget.hidden">${msg}</p>
</div>
