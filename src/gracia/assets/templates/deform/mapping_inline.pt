<tal:def tal:define="errormsg errormsg|field.errormsg;
                     item_template item_template|field.widget.item_template"
         i18n:domain="deform">
  <div tal:condition="errormsg" class="alert alert-danger py-1 mb-1">${errormsg}</div>
  ${field.start_mapping()}
  <div class="d-flex gap-2 mapping-inline">
    <div tal:repeat="child field.children"
         tal:replace="structure child.render_template(item_template)"></div>
  </div>
  ${field.end_mapping()}
</tal:def>
