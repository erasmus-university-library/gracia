<div tal:define="item_tmpl item_template|field.widget.item_template;
                 oid oid|field.oid;
                 url url|None;
                 path path|'';
                 focus_index focus_index|None;
                 labelled labelled|None;
                 min_len min_len|field.widget.min_len;
                 min_len min_len or 0;
                 max_len max_len|field.widget.max_len;
                 now_len len(subfields)"
     class="bag list mb-3"
     id="${oid}" role="group" aria-labelledby="req-${oid}"
     tal:attributes="hx-post url or None;
                     hx-trigger 'reorder' if url else None;
                     hx-include 'closest form' if url else None;
                     hx-target '#' + oid if url else None;
                     hx-swap 'outerHTML' if url else None;
                     hx-vals '{&quot;sequence&quot;: &quot;' + path + '&quot;, &quot;action&quot;: &quot;reorder&quot;}' if url else None;
                     data-list-oid oid">
  <!-- an rdf:list (gracia.forms.ListWidget): a bag whose rows have a handle that moves
       them (list.js); the order of the rows is the order of the list. When a row has been
       moved the server (htmx, the event `reorder` of this element) shows the rows again, so
       that the + is at the last row and the x at the others -->
  <input type="hidden" name="__start__" value="${field.name}:sequence"/>
  <div class="bag-items">
    <div tal:define="subfields [ x[1] for x in subfields ]"
         tal:repeat="subfield subfields"
         tal:replace="structure subfield.render_template(item_tmpl,
                                                      parent=field,
                                                      target=oid,
                                                      url=url,
                                                      path=path,
                                                      index=repeat.subfield.index,
                                                      last=repeat.subfield.index == now_len - 1,
                                                      add_text=add_subitem_text,
                                                      labelled=labelled,
                                                      autofocus=repeat.subfield.index == focus_index,
                                                      can_add=max_len is None or now_len < max_len,
                                                      can_remove=now_len > min_len)" />
  </div>
  <div class="text-danger small mt-1" tal:condition="field.error and field.error.messages()"
       tal:repeat="msg field.error.messages()">${msg}</div>
  <input type="hidden" name="__end__" value="${field.name}:sequence"/>
</div>
