<div tal:define="target target|field.oid;
                 url url|None;
                 path path|'';
                 index index|0;
                 last last|True;
                 add_text add_text|'Add';
                 can_add can_add|True;
                 can_remove can_remove|True;
                 autofocus autofocus|False;
                 labelled labelled|None;
                 parent parent|None;
                 label ((parent.title if parent is not None else field.title) + ' ' + str(index + 1));
                 takes_addon getattr(field.widget, 'takes_addon', False);
                 addon field.renderer('bag_button', field=field, target=target, url=url,
                                      path=path, index=index, last=last, add_text=add_text, label=label,
                                      can_add=can_add, can_remove=can_remove) if url else ''"
     class="bag-item mb-2"
     tal:attributes="data-autofocus 'data-autofocus' if autofocus else None"
     i18n:domain="deform">
  <!-- one value of a bag (bag.pt): whatever the widget of the item makes, with the button
       that adds a row (the last row) or takes this one away (the others) as an addon at
       the end of it: in the group of the widget when it has one (a LanguageWidget), else in a
       group of its own -->
  <span tal:condition="takes_addon" tal:replace="structure field.serialize(cstruct, addon=addon, label=label)"/>
  <div tal:condition="not takes_addon" class="input-group">
    <span tal:replace="structure field.serialize(cstruct, attributes=labelled(field, label)).strip()"/>
    <span tal:replace="structure addon"/>
  </div>
  <div class="text-danger small" tal:condition="field.error and not field.children"
       id="error-${field.oid}"
       tal:repeat="msg field.error.messages()">${msg}</div>
</div>
