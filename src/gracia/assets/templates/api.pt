<html metal:use-macro="layout.macros['layout']">
  <metal:slot fill-slot="header">
    <h1 class="h3 mb-0">${heading}</h1>
    <div class="text-muted">${subtitle}</div>
  </metal:slot>

  <metal:slot fill-slot="content">
    <div id="api" data-base="${base}">
      <p class="small">
        <a href="${document_url}" data-json>The OpenAPI document</a>
        (JSON, for the caller you are now).
      </p>
      <div class="card mb-3" tal:repeat="op operations" data-operation="">
        <div class="card-body">
          <div class="d-flex align-items-baseline gap-2 flex-wrap">
            <span class="badge ${'text-bg-success' if op['method'] == 'GET' else 'text-bg-warning'}">${op['method']}</span>
            <code class="op-path">${op['path']}</code>
            <span class="badge text-bg-light border ms-auto">${op['x-gracia-permission']}</span>
          </div>
          <div class="mt-1">${op['summary']}</div>
          <div class="mt-2 try" tal:condition="op['method'] == 'GET'"
               data-path="${op['path']}" data-method="GET">
            <form class="row g-2 align-items-end">
              <div class="col-auto" data-inputs=""></div>
              <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-primary">Try it</button>
              </div>
            </form>
            <div class="mt-2 small text-muted d-none" data-status=""></div>
            <pre class="mt-2 mb-0 p-2 bg-light border rounded d-none small" data-body=""
                 style="max-height: 20rem; overflow: auto"></pre>
          </div>
          <div class="mt-2 small text-muted" tal:condition="op['method'] != 'GET'">
            Not tried from here: it changes something.
          </div>
        </div>
      </div>
      <p class="text-muted" tal:condition="not operations">Nothing here is open to you.</p>
    </div>
  </metal:slot>

</html>
